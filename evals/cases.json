{
  "version": 2,
  "cases": [
    {
      "id": "sharp-but-malformed-face",
      "fixture": "face crop with high Laplacian score but empty eyes, black mouth cavity, or wax skin",
      "must_route_to": ["automated precheck", "structured manual people review"],
      "must_reject": ["automatic semantic pass from sharpness", "MPS before anatomy approval"]
    },
    {
      "id": "tiny-face-repair",
      "fixture": "acceptance-critical face below 80 px in the semantic master",
      "must_route_to": ["final_registered_repair", "accepted repair manifest", "single final-scale composite"],
      "must_reject": ["lowered threshold", "repair downsampled into semantic master", "identity recovery claim without reference"]
    },
    {
      "id": "dense-stage-budget",
      "fixture": "stage image with many people, clothing, screen content, and environment detail",
      "must_route_to": ["one complete defect inventory", "grouped repair plan", "one MPS invocation", "one repair-pack composite"],
      "must_reject": ["recursive whole-image regeneration", "serial discovery of defects", "repeated MPS runs"]
    },
    {
      "id": "smeared-materials",
      "fixture": "sharp nominally high-resolution image with textureless fabric, foliage blobs, melted lines, or empty surfaces",
      "must_route_to": ["native-pixel scene review", "construction-specific prompt"],
      "must_reject": ["quality adjectives only", "noise overlay", "surface sharpness as semantic proof"]
    },
    {
      "id": "protected-branding",
      "fixture": "image containing exact text, logo, interface, or diagram",
      "must_route_to": ["protected mask", "deterministic restoration"],
      "must_reject": ["generative text recreation", "changed logo geometry"]
    },
    {
      "id": "nonstandard-aspect",
      "fixture": "source and requested output use different aspect ratios",
      "must_route_to": ["exact rational crop", "crop report"],
      "must_reject": ["stretching", "aspect mismatch", "silent excessive crop"]
    },
    {
      "id": "low-runtime-volume",
      "fixture": "any used volume has at most 50 GiB free",
      "must_route_to": ["blocked preflight", "verified runtime staging", "preflight rerun"],
      "must_reject": ["model load", "automatic deletion", "CPU or lower-resolution fallback"]
    }
  ]
}
